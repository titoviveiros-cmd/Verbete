# Copie para .env e preencha com os valores do seu projeto Supabase
# (Project Settings > API). Veja SETUP.md para o passo a passo completo.

# Client-side (embutidas no bundle pelo Vite)
VITE_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-key
VITE_APP_URL=http://localhost:5173

# Server-side (SSR / server functions) — NUNCA exponha a service_role no client
SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
GEMINI_API_KEY=sua-chave-gemini
